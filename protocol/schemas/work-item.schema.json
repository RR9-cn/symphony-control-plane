{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fshows.local/schemas/work-item.schema.json",
  "title": "Fshows Control Plane WorkItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "feature_id",
    "parent_id",
    "title",
    "description",
    "stage",
    "agent_role",
    "status",
    "priority",
    "version",
    "repository",
    "dependencies",
    "input_artifacts",
    "output_artifacts",
    "acceptance_criteria",
    "blocker",
    "claim",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^WI-[0-9]{3,}$" },
    "feature_id": { "type": "string", "pattern": "^FEATURE-[0-9]{3,}$" },
    "parent_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^WI-[0-9]{3,}$" }
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "tech_analysis",
        "implementation",
        "code_review",
        "test_design",
        "test_execution"
      ]
    },
    "agent_role": {
      "enum": [
        "solution_architect",
        "backend_builder",
        "code_reviewer",
        "test_designer",
        "test_executor"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "running",
        "needs_human",
        "blocked",
        "stage_review",
        "rework",
        "retry_queued",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "description": "0 is highest and 4 is lowest.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "version": { "type": "integer", "minimum": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^WI-[0-9]{3,}$" }
    },
    "input_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "output_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "blocker": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/blocker" }
      ]
    },
    "claim": { "$ref": "#/$defs/claim" },
    "created_at": { "$ref": "#/$defs/nullableTimestamp" },
    "updated_at": { "$ref": "#/$defs/nullableTimestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "agent_role": { "const": "solution_architect" } } },
      "then": { "properties": { "stage": { "const": "tech_analysis" } } }
    },
    {
      "if": { "properties": { "agent_role": { "const": "backend_builder" } } },
      "then": { "properties": { "stage": { "const": "implementation" } } }
    },
    {
      "if": { "properties": { "agent_role": { "const": "code_reviewer" } } },
      "then": { "properties": { "stage": { "const": "code_review" } } }
    },
    {
      "if": { "properties": { "agent_role": { "const": "test_designer" } } },
      "then": { "properties": { "stage": { "const": "test_design" } } }
    },
    {
      "if": { "properties": { "agent_role": { "const": "test_executor" } } },
      "then": { "properties": { "stage": { "const": "test_execution" } } }
    },
    {
      "if": { "properties": { "status": { "const": "running" } } },
      "then": {
        "properties": {
          "claim": {
            "type": "object",
            "properties": {
              "worker_id": { "type": "string", "minLength": 1 },
              "token": { "type": "string", "minLength": 16 },
              "expires_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "claim": {
            "type": "object",
            "properties": {
              "worker_id": { "type": "null" },
              "token": { "type": "null" },
              "expires_at": { "type": "null" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "nullableTimestamp": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "base_branch", "head_branch", "commit", "pull_request"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "head_branch": { "type": ["string", "null"], "minLength": 1 },
        "commit": { "type": ["string", "null"], "minLength": 7 },
        "pull_request": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "revision": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "since"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "since": { "type": "string", "format": "date-time" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "token", "expires_at"],
      "properties": {
        "worker_id": { "type": ["string", "null"] },
        "token": { "type": ["string", "null"] },
        "expires_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    }
  }
}
