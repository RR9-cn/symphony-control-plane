ACP_DATABASE_URL=sqlite+aiosqlite:///./data/control-plane.db
ACP_SQL_ECHO=false
ACP_LEASE_SWEEP_INTERVAL_SECONDS=5
ACP_DEFAULT_RETRY_DELAY_SECONDS=5
ACP_ENABLE_LEASE_SWEEPER=true
ACP_WORKER_OFFLINE_AFTER_SECONDS=20
ACP_ISSUE_WORKSPACE_ROOT=.workspaces
ACP_MANAGED_RUNNER_WORKFLOW=WORKFLOW.md
ACP_MANAGED_RUNNER_AUTOSTART=false
ACP_MANAGED_RUNNER_WORKER_ID=windows-symphony-managed
ACP_API_TOKEN=replace-with-a-random-host-only-token
CONTROL_PLANE_TOKEN=replace-with-the-same-host-only-token
ACP_GITLAB_TOKEN=
